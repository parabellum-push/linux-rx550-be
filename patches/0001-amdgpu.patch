From: RX550 G5 port
Subject: [PATCH 1/4] drm/amdgpu: big-endian fixes for Polaris (GFX8) on PowerPC

---
diff -ruN a/drivers/gpu/drm/amd/amdgpu/amdgpu_atombios.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_atombios.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_atombios.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_atombios.c
@@ -24,6 +24,7 @@
  *          Alex Deucher
  */
 
+#include <linux/unaligned.h>
 #include <drm/amdgpu_drm.h>
 #include "amdgpu.h"
 #include "amdgpu_atombios.h"
@@ -1022,6 +1023,7 @@
 	struct _COMPUTE_MEMORY_ENGINE_PLL_PARAMETERS_V5 v5;
 	struct _COMPUTE_GPU_CLOCK_INPUT_PARAMETERS_V1_6 v6_in;
 	struct _COMPUTE_GPU_CLOCK_OUTPUT_PARAMETERS_V1_6 v6_out;
+	struct _COMPUTE_GPU_CLOCK_OUTPUT_PARAMETERS_V1_7 v7_out;
 };
 
 int amdgpu_atombios_get_clock_dividers(struct amdgpu_device *adev,
@@ -1089,20 +1091,24 @@
 		break;
 	case 4:
 		/* fusion */
-		args.v4.ulClock = cpu_to_le32(clock);	/* 10 khz */
+		put_unaligned_le32(clock & SET_CLOCK_FREQ_MASK, &args.v4);
 
 		if (amdgpu_atom_execute_table(adev->mode_info.atom_context,
 		    index, (uint32_t *)&args, sizeof(args)))
 			return -EINVAL;
 
-		dividers->post_divider = dividers->post_div = args.v4.ucPostDiv;
-		dividers->real_clock = le32_to_cpu(args.v4.ulClock);
+		dividers->post_divider = dividers->post_div =
+			get_unaligned_le32(&args.v4) >> 24;
+		dividers->real_clock = get_unaligned_le32(&args.v4) & SET_CLOCK_FREQ_MASK;
 		break;
 	case 6:
 		/* CI */
 		/* COMPUTE_GPUCLK_INPUT_FLAG_DEFAULT_GPUCLK, COMPUTE_GPUCLK_INPUT_FLAG_SCLK */
-		args.v6_in.ulClock.ulComputeClockFlag = clock_type;
-		args.v6_in.ulClock.ulClockFreq = cpu_to_le32(clock);	/* 10 khz */
+		put_unaligned_le32((clock & SET_CLOCK_FREQ_MASK) | ((u32)clock_type << 24),
+				   &args.v6_in.ulClock);
+		if (adev->asic_type == CHIP_POLARIS11)
+			dev_dbg(adev->dev, "ATOM-PLL-CODEC: clock=%u type=%u parameter=%4ph\n",
+				 clock, clock_type, &args.v6_in.ulClock);
 
 		if (amdgpu_atom_execute_table(adev->mode_info.atom_context,
 		    index, (uint32_t *)&args, sizeof(args)))
@@ -1113,8 +1119,11 @@
 		dividers->ref_div = args.v6_out.ucPllRefDiv;
 		dividers->post_div = args.v6_out.ucPllPostDiv;
 		dividers->flags = args.v6_out.ucPllCntlFlag;
-		dividers->real_clock = le32_to_cpu(args.v6_out.ulClock.ulClock);
-		dividers->post_divider = args.v6_out.ulClock.ucPostDiv;
+		dividers->real_clock = get_unaligned_le32(&args.v6_out.ulClock) & SET_CLOCK_FREQ_MASK;
+		dividers->post_divider = get_unaligned_le32(&args.v6_out.ulClock) >> 24;
+		if (adev->asic_type == CHIP_POLARIS11)
+			dev_dbg(adev->dev, "ATOM-PLL-CODEC: clock=%u real=%u postdiv=%u\n",
+				 clock, dividers->real_clock, dividers->post_divider);
 		break;
 	default:
 		return -EINVAL;
