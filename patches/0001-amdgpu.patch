+static inline u32 amdgpu_ring_endian_dword(struct amdgpu_ring *ring, u32 v)
+{
+#ifdef __BIG_ENDIAN
+	if (ring->use_le_cpu_ring)
+		return cpu_to_le32(v);
+#endif
+	return v;
+}
+
 static inline void amdgpu_ring_set_preempt_cond_exec(struct amdgpu_ring *ring,
-							bool cond_exec)
+						       bool cond_exec)
 {
-	*ring->cond_exe_cpu_addr = cond_exec;
+	*ring->cond_exe_cpu_addr = amdgpu_ring_endian_dword(ring, cond_exec);
 }
 
 static inline void amdgpu_ring_clear_ring(struct amdgpu_ring *ring)
 {
-	memset32(ring->ring, ring->funcs->nop, ring->buf_mask + 1);
+	memset32(ring->ring,
+		 amdgpu_ring_endian_dword(ring, ring->funcs->nop),
+		 ring->buf_mask + 1);
 }
 
 static inline void amdgpu_ring_write(struct amdgpu_ring *ring, uint32_t v)
 {
-	ring->ring[ring->wptr++ & ring->buf_mask] = v;
+	ring->ring[ring->wptr++ & ring->buf_mask] =
+		amdgpu_ring_endian_dword(ring, v);
 	ring->wptr &= ring->ptr_mask;
 	ring->count_dw--;
 }
