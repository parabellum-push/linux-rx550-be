+/*
+ * VCE firmware stalls when a command straddles the end of the ring: it consumes the ring but
+ * never completes the job. Seen as a first-pass hang at fixed fence numbers. Keep each command
+ * contiguous by padding to the wrap. Each frame wraps at most once, so this costs at most
+ * VCE_MAX_CMD_DW - 1 no-ops per frame; emit_frame_size reserves them.
+ */
+#define VCE_MAX_CMD_DW 5
+static void vce_v3_0_ring_keep_contiguous(struct amdgpu_ring *ring, unsigned int count)
+{
+	unsigned int left = ring->buf_mask + 1 - (ring->wptr & ring->buf_mask);
+
+	if (left < count)
+		amdgpu_ring_insert_nop(ring, left);
+}
