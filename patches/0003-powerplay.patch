+static void smu7_g5_dpm_diag(struct pp_hwmgr *hwmgr, const char *stage, int result)
+{
+	struct amdgpu_device *adev = hwmgr->adev;
+
+	if (adev->asic_type == CHIP_POLARIS11) {
+		if (result)
+			dev_err(adev->dev, "PP-DPM-STEP: stage=%s result=%d\n", stage, result);
+		else
+			dev_dbg(adev->dev, "PP-DPM-STEP: stage=%s result=%d\n", stage, result);
+	}
+}
+
+static int smu7_g5_dpm_send_msg(struct pp_hwmgr *hwmgr, uint16_t msg,
+                               const char *name)
+{
+	struct amdgpu_device *adev = hwmgr->adev;
+	int result;
+
+	if (adev->asic_type == CHIP_POLARIS11)
+		dev_dbg(adev->dev, "PP-DPM-MSG: name=%s id=%04x enter\n", name, msg);
+	result = smum_send_msg_to_smc(hwmgr, msg, NULL);
+	if (adev->asic_type == CHIP_POLARIS11) {
+		if (result)
+			dev_err(adev->dev, "PP-DPM-MSG: name=%s id=%04x leave result=%d\n",
+				name, msg, result);
+		else
+			dev_dbg(adev->dev, "PP-DPM-MSG: name=%s id=%04x leave result=%d\n",
+				name, msg, result);
+	}
+	return result;
+}
