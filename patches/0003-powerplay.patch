From: RX550 G5 port
Subject: [PATCH 3/4] drm/amd/pm: big-endian fixes for powerplay (SMU7/Polaris tables)

---
diff -ruN a/drivers/gpu/drm/amd/pm/powerplay/hwmgr/hwmgr.c b/drivers/gpu/drm/amd/pm/powerplay/hwmgr/hwmgr.c
--- a/drivers/gpu/drm/amd/pm/powerplay/hwmgr/hwmgr.c
+++ b/drivers/gpu/drm/amd/pm/powerplay/hwmgr/hwmgr.c
@@ -225,6 +225,18 @@
 	return 0;
 }
 
+static void hwmgr_g5_diag(struct pp_hwmgr *hwmgr, const char *stage, int result)
+{
+	struct amdgpu_device *adev = hwmgr->adev;
+
+	if (adev->asic_type == CHIP_POLARIS11) {
+		if (result)
+			dev_err(adev->dev, "PP-DIAG: stage=%s result=%d\n", stage, result);
+		else
+			dev_dbg(adev->dev, "PP-DIAG: stage=%s result=%d\n", stage, result);
+	}
+}
+
 int hwmgr_hw_init(struct pp_hwmgr *hwmgr)
 {
 	int ret = 0;
@@ -232,8 +244,10 @@
 	hwmgr->pp_one_vf = amdgpu_sriov_is_pp_one_vf((struct amdgpu_device *)hwmgr->adev);
 	hwmgr->pm_en = (amdgpu_dpm && (hwmgr->not_vf || hwmgr->pp_one_vf))
 			? true : false;
-	if (!hwmgr->pm_en)
+	if (!hwmgr->pm_en) {
+		hwmgr_g5_diag(hwmgr, "dynamic-power-management-disabled", 0);
 		return 0;
+	}
 
 	if (!hwmgr->pptable_func ||
 	    !hwmgr->pptable_func->pptable_init ||
@@ -243,14 +257,18 @@
 		return 0;
 	}
 
+	hwmgr_g5_diag(hwmgr, "pptable-init-enter", 0);
 	ret = hwmgr->pptable_func->pptable_init(hwmgr);
+	hwmgr_g5_diag(hwmgr, "pptable-init-leave", ret);
 	if (ret)
 		goto err;
 
 	((struct amdgpu_device *)hwmgr->adev)->pm.no_fan =
 				hwmgr->thermal_controller.fanInfo.bNoFan;
 
+	hwmgr_g5_diag(hwmgr, "backend-init-enter", 0);
 	ret = hwmgr->hwmgr_func->backend_init(hwmgr);
+	hwmgr_g5_diag(hwmgr, "backend-init-leave", ret);
 	if (ret)
 		goto err1;
  /* make sure dc limits are valid */
@@ -259,19 +277,29 @@
 			hwmgr->dyn_state.max_clock_voltage_on_dc =
 					hwmgr->dyn_state.max_clock_voltage_on_ac;
 
+	hwmgr_g5_diag(hwmgr, "power-state-table-enter", 0);
 	ret = psm_init_power_state_table(hwmgr);
+	hwmgr_g5_diag(hwmgr, "power-state-table-leave", ret);
 	if (ret)
 		goto err2;
 
+	hwmgr_g5_diag(hwmgr, "setup-asic-enter", 0);
 	ret = phm_setup_asic(hwmgr);
+	hwmgr_g5_diag(hwmgr, "setup-asic-leave", ret);
 	if (ret)
 		goto err2;
 
+	hwmgr_g5_diag(hwmgr, "enable-dpm-enter", 0);
 	ret = phm_enable_dynamic_state_management(hwmgr);
+	hwmgr_g5_diag(hwmgr, "enable-dpm-leave", ret);
 	if (ret)
 		goto err2;
+	hwmgr_g5_diag(hwmgr, "thermal-controller-enter", 0);
 	ret = phm_start_thermal_controller(hwmgr);
+	hwmgr_g5_diag(hwmgr, "thermal-controller-leave", ret);
+	hwmgr_g5_diag(hwmgr, "performance-states-enter", 0);
 	ret |= psm_set_performance_states(hwmgr);
+	hwmgr_g5_diag(hwmgr, "performance-states-leave", ret);
 	if (ret)
 		goto err2;
 
