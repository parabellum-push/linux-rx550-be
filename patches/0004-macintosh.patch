From: RX550 G5 port
Subject: [PATCH 4/4] macintosh: g5_cpu_temp, hwmon view of the Power Mac G5 windfarm temperature sensors

---
diff -ruN a/drivers/macintosh/g5_cpu_temp.c b/drivers/macintosh/g5_cpu_temp.c
--- a/drivers/macintosh/g5_cpu_temp.c
+++ b/drivers/macintosh/g5_cpu_temp.c
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Expose the Power Mac G5 windfarm temperature sensors through hwmon, so generic tools can
+ * find them. Windfarm itself only publishes them as attributes on its platform device.
+ * Read-only: fan control stays with the stock windfarm_pm112 driver.
+ */
+#include <linux/err.h>
+#include <linux/hwmon.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/notifier.h>
+#include <linux/platform_device.h>
+#include <linux/string.h>
+#include "windfarm.h"
+
+enum { CH_PACKAGE, CH_CORE0, CH_CORE1, CH_BACKSIDE, CH_DISK, CH_COUNT };
+
+static const char * const labels[CH_COUNT] = {
+	"Package id 0", "Core 0", "Core 1", "Backside", "Hard disk",
+};
+static const char * const wf_names[CH_COUNT] = {
+	NULL, "cpu-temp-0", "cpu-temp-1", "backside-temp", "hd-temp",
+};
+
+static DEFINE_MUTEX(sensors_lock);
+static struct wf_sensor *sensors[CH_COUNT];
+static struct platform_device *pdev;
+static struct device *hwmon;
+
+static int read_millic(int ch, long *val)
+{
+	s32 fix;
+	int err;
+
+	if (!sensors[ch])
+		return -ENODATA;
+	err = wf_sensor_get(sensors[ch], &fix);
+	if (err < 0)
+		return err;
+	*val = ((s64)fix * 1000) >> 16;	/* 16.16 fixed point degrees */
+	return 0;
+}
+
+static int temp_read(struct device *dev, enum hwmon_sensor_types type, u32 attr, int ch, long *val)
+{
+	long a, b;
+	int ea, eb, err;
+
+	if (type != hwmon_temp || attr != hwmon_temp_input)
+		return -EOPNOTSUPP;
+	mutex_lock(&sensors_lock);
+	if (ch == CH_PACKAGE) {
+		/* The hottest core, since there is no separate package sensor. */
+		ea = read_millic(CH_CORE0, &a);
+		eb = read_millic(CH_CORE1, &b);
+		err = ea && eb ? ea : 0;
+		if (!err)
+			*val = ea ? b : eb ? a : max(a, b);
+	} else {
+		err = read_millic(ch, val);
+	}
+	mutex_unlock(&sensors_lock);
+	return err;
+}
+
+static int temp_read_string(struct device *dev, enum hwmon_sensor_types type, u32 attr, int ch,
+			    const char **str)
+{
+	if (type != hwmon_temp || attr != hwmon_temp_label)
+		return -EOPNOTSUPP;
+	*str = labels[ch];
+	return 0;
+}
+
+static umode_t temp_visible(const void *data, enum hwmon_sensor_types type, u32 attr, int ch)
+{
+	return type == hwmon_temp ? 0444 : 0;
+}
+
+static const struct hwmon_ops temp_ops = {
+	.is_visible = temp_visible,
+	.read = temp_read,
+	.read_string = temp_read_string,
+};
+
+static const struct hwmon_channel_info * const temp_info[] = {
+	HWMON_CHANNEL_INFO(temp,
+			   HWMON_T_INPUT | HWMON_T_LABEL, HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL, HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL),
+	NULL
+};
+
+static const struct hwmon_chip_info temp_chip = {
+	.ops = &temp_ops,
+	.info = temp_info,
+};
+
+static int wf_event(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct wf_sensor *sr = data;
+	int i;
+
+	if (event != WF_EVENT_NEW_SENSOR)
+		return 0;
+	for (i = 0; i < CH_COUNT; i++) {
+		if (!wf_names[i] || strcmp(sr->name, wf_names[i]))
+			continue;
+		mutex_lock(&sensors_lock);
+		if (!sensors[i] && !wf_get_sensor(sr))
+			sensors[i] = sr;
+		mutex_unlock(&sensors_lock);
+	}
+	return 0;
+}
+
+static struct notifier_block wf_nb = { .notifier_call = wf_event };
+
+static int __init g5_cpu_temp_init(void)
+{
+	int err;
+
+	if (!of_machine_is_compatible("PowerMac11,2"))
+		return -ENODEV;
+	pdev = platform_device_register_simple("g5_cpu_temp", -1, NULL, 0);
+	if (IS_ERR(pdev))
+		return PTR_ERR(pdev);
+	hwmon = hwmon_device_register_with_info(&pdev->dev, "g5_cpu_temp", NULL, &temp_chip, NULL);
+	if (IS_ERR(hwmon)) {
+		err = PTR_ERR(hwmon);
+		platform_device_unregister(pdev);
+		return err;
+	}
+	wf_register_client(&wf_nb);
+	return 0;
+}
+
+static void __exit g5_cpu_temp_exit(void)
+{
+	int i;
+
+	wf_unregister_client(&wf_nb);
+	hwmon_device_unregister(hwmon);
+	platform_device_unregister(pdev);
+	for (i = 0; i < CH_COUNT; i++)
+		if (sensors[i])
+			wf_put_sensor(sensors[i]);
+}
+
+module_init(g5_cpu_temp_init);
+module_exit(g5_cpu_temp_exit);
+MODULE_DESCRIPTION("hwmon view of Power Mac G5 windfarm temperature sensors");
+MODULE_LICENSE("GPL");
diff -ruN a/drivers/macintosh/Makefile b/drivers/macintosh/Makefile
--- a/drivers/macintosh/Makefile
+++ b/drivers/macintosh/Makefile
@@ -64,3 +64,6 @@
 obj-$(CONFIG_PMAC_RACKMETER)	+= rack-meter.o
 
 obj-$(CONFIG_SENSORS_AMS)	+= ams/
+
+# Power Mac G5: windfarm CPU, backside and drive-bay temperatures as hwmon (RX550 G5 port).
+obj-$(CONFIG_WINDFARM_PM112) += g5_cpu_temp.o
