--- a/drivers/gpu/drm/amd/display/dc/bios/bios_parser.c
+++ b/drivers/gpu/drm/amd/display/dc/bios/bios_parser.c
@@ -25,6 +25,7 @@
 
 #include <linux/slab.h>
 
+#include <linux/unaligned.h>
 #include "dm_services.h"
 
 #include "atom.h"
@@ -51,7 +52,7 @@
 #define DC_LOGGER \
 	bp->base.ctx->logger
 
-#define DATA_TABLES(table) (bp->master_data_tbl->ListOfDataTables.table)
+#define DATA_TABLES(table) le16_to_cpu(bp->master_data_tbl->ListOfDataTables.table)
 
 static void get_atom_data_table_revision(
 	ATOM_COMMON_TABLE_HEADER *atom_data_tbl,
@@ -208,7 +209,7 @@
 	if (number <= index)
 		return BP_RESULT_BADINPUT;
 
-	*src_object_id = object_id_from_bios_object_id(id[index]);
+	*src_object_id = object_id_from_bios_object_id(get_unaligned_le16(&id[index]));
 
 	return BP_RESULT_OK;
 }
@@ -447,13 +448,13 @@
 		le32_to_cpu(firmware_info->ulMaxPixelClockPLL_Output) * 10;
 	info->max_pixel_clock = le16_to_cpu(firmware_info->usMaxPixelClock) * 10;
 
-	if (firmware_info->usFirmwareCapability.sbfAccess.MemoryClockSS_Support)
+	if ((le16_to_cpu(firmware_info->usFirmwareCapability.susAccess) & BIT(3)))
 		/* Since there is no information on the SS, report conservative
 		 * value 3% for bandwidth calculation */
 		/* unit of 0.01% */
 		info->feature.memory_clk_ss_percentage = THREE_PERCENT_OF_10000;
 
-	if (firmware_info->usFirmwareCapability.sbfAccess.EngineClockSS_Support)
+	if ((le16_to_cpu(firmware_info->usFirmwareCapability.susAccess) & BIT(4)))
 		/* Since there is no information on the SS,report conservative
 		 * value 3% for bandwidth calculation */
 		/* unit of 0.01% */
@@ -507,7 +508,7 @@
 	/* There should be only one entry in the SS info table for Memory Clock
 	 */
 	index = 0;
-	if (firmwareInfo->usFirmwareCapability.sbfAccess.MemoryClockSS_Support)
+	if ((le16_to_cpu(firmwareInfo->usFirmwareCapability.susAccess) & BIT(3)))
 		/* Since there is no information for external SS, report
 		 *  conservative value 3% for bandwidth calculation */
 		/* unit of 0.01% */
@@ -530,7 +531,7 @@
 	/* There should be only one entry in the SS info table for Engine Clock
 	 */
 	index = 1;
-	if (firmwareInfo->usFirmwareCapability.sbfAccess.EngineClockSS_Support)
+	if ((le16_to_cpu(firmwareInfo->usFirmwareCapability.susAccess) & BIT(4)))
 		/* Since there is no information for external SS, report
 		 * conservative value 3% for bandwidth calculation */
 		/* unit of 0.01% */
@@ -592,7 +593,7 @@
 	/* There should be only one entry in the SS info table for Memory Clock
 	 */
 	index = 0;
-	if (firmware_info->usFirmwareCapability.sbfAccess.MemoryClockSS_Support)
+	if ((le16_to_cpu(firmware_info->usFirmwareCapability.susAccess) & BIT(3)))
 		/* Since there is no information for external SS, report
 		 *  conservative value 3% for bandwidth calculation */
 		/* unit of 0.01% */
@@ -615,7 +616,7 @@
 	/* There should be only one entry in the SS info table for Engine Clock
 	 */
 	index = 1;
-	if (firmware_info->usFirmwareCapability.sbfAccess.EngineClockSS_Support)
+	if ((le16_to_cpu(firmware_info->usFirmwareCapability.susAccess) & BIT(4)))
 		/* Since there is no information for external SS, report
 		 * conservative value 3% for bandwidth calculation */
 		/* unit of 0.01% */
@@ -1640,6 +1641,7 @@
 	struct bios_parser *bp = BP_FROM_DCB(dcb);
 	ATOM_OBJECT *object;
 	ATOM_ENCODER_CAP_RECORD_V2 *record = NULL;
+	u16 cap;
 
 	if (!info)
 		return BP_RESULT_BADINPUT;
@@ -1653,9 +1655,11 @@
 	if (!record)
 		return BP_RESULT_NORECORD;
 
-	info->DP_HBR2_EN = record->usHBR2En;
-	info->DP_HBR3_EN = record->usHBR3En;
-	info->HDMI_6GB_EN = record->usHDMI6GEn;
+	/* The record is raw VBIOS data, so usEncoderCap is little endian. */
+	cap = get_unaligned_le16(&record->usEncoderCap);
+	info->DP_HBR2_EN = !!(cap & BIT(1));
+	info->DP_HBR3_EN = !!(cap & BIT(3));
+	info->HDMI_6GB_EN = !!(cap & BIT(2));
 	return BP_RESULT_OK;
 }
 
@@ -2415,7 +2419,7 @@
 	uint32_t i;
 
 	info_v8 = GET_IMAGE(ATOM_INTEGRATED_SYSTEM_INFO_V1_8,
-			bp->master_data_tbl->ListOfDataTables.IntegratedSystemInfo);
+			DATA_TABLES(IntegratedSystemInfo));
 
 	if (info_v8 == NULL)
 		return BP_RESULT_BADBIOSTABLE;
@@ -2556,7 +2560,7 @@
 	uint32_t i;
 
 	info_v9 = GET_IMAGE(ATOM_INTEGRATED_SYSTEM_INFO_V1_9,
-			bp->master_data_tbl->ListOfDataTables.IntegratedSystemInfo);
+			DATA_TABLES(IntegratedSystemInfo));
 
 	if (!info_v9)
 		return BP_RESULT_BADBIOSTABLE;
@@ -2686,9 +2690,9 @@
 	ATOM_COMMON_TABLE_HEADER *header;
 	struct atom_data_revision revision;
 
-	if (bp->master_data_tbl->ListOfDataTables.IntegratedSystemInfo) {
+	if (DATA_TABLES(IntegratedSystemInfo)) {
 		header = GET_IMAGE(ATOM_COMMON_TABLE_HEADER,
-				bp->master_data_tbl->ListOfDataTables.IntegratedSystemInfo);
+				DATA_TABLES(IntegratedSystemInfo));
 
 		get_atom_data_table_revision(header, &revision);
 
@@ -3022,7 +3026,7 @@
 	if (!rom_header_offset)
 		return false;
 
-	rom_header = GET_IMAGE(ATOM_ROM_HEADER, *rom_header_offset);
+	rom_header = GET_IMAGE(ATOM_ROM_HEADER, le16_to_cpu(*rom_header_offset));
 
 	if (!rom_header)
 		return false;
@@ -3033,7 +3037,7 @@
 
 	bp->master_data_tbl =
 	GET_IMAGE(ATOM_MASTER_DATA_TABLE,
-		rom_header->usMasterDataTableOffset);
+		le16_to_cpu(rom_header->usMasterDataTableOffset));
 
 	if (!bp->master_data_tbl)
 		return false;
